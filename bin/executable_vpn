#!/usr/bin/env bash
set -euo pipefail

WG_SERVICE="awg-quick@wg0.service"
XRAY_SERVICE="xray-knife.service"

# ANSI colors
RED=$'\033[31m'
GREEN=$'\033[32m'
RESET=$'\033[0m'

usage() {
    cat <<'EOF'
Usage: vpn <command>

Commands:
  cycle                     Cycle state: off → wg → xray → off
  off                       Stop all VPN services
  wg                        Switch to WireGuard (awg-quick@wg0)
  xray                      Switch to Xray (xray-knife)
  status                    Print current state: off | wg | xray
  status --full             Print full systemctl status of active service
  status -s                 Print symbol: ⓞ | ⓦ | ⓧ
                            (alias: --symbol)
  status -cs                Print colored symbol (red=off, green=on)
                            (alias: --coloredsymbol)
  help, -h, --help          Show this help

Run with no arguments to print this usage.
EOF
}

get_status() {
    if systemctl is-active --quiet "$WG_SERVICE"; then
        echo "wg"
    elif systemctl --user is-active --quiet "$XRAY_SERVICE"; then
        echo "xray"
    else
        echo "off"
    fi
}

get_symbol() {
    case "$(get_status)" in
        off)  echo "ⓞ" ;;   # U+24DE
        wg)   echo "ⓦ" ;;   # U+24E6
        xray) echo "ⓧ" ;;   # U+24E7
    esac
}

get_symbol_colored() {
    local s
    s="$(get_status)"
    case "$s" in
        off)     printf '%s%s%s\n' "$RED"   "$(get_symbol)" "$RESET" ;;
        wg|xray) printf '%s%s%s\n' "$GREEN" "$(get_symbol)" "$RESET" ;;
    esac
}

status_full() {
    local cur
    cur="$(get_status)"

    case "$cur" in
        off)
            echo "off"
            return 0
            ;;
        wg)
            echo "=== $WG_SERVICE (system) ==="
            if systemctl list-unit-files --no-legend "$WG_SERVICE" 2>/dev/null | grep -q .; then
                systemctl status -l "$WG_SERVICE" --no-pager || true
            else
                echo "unit not found"
            fi
            ;;
        xray)
            echo "=== $XRAY_SERVICE (user) ==="
            if systemctl --user list-unit-files --no-legend "$XRAY_SERVICE" 2>/dev/null | grep -q .; then
                systemctl --user status -l "$XRAY_SERVICE" --no-pager || true
            else
                echo "unit not found"
            fi
            ;;
    esac
}

wait_inactive() {
    local scope="$1" svc="$2" i
    for i in $(seq 1 30); do
        if [[ "$scope" == "user" ]]; then
            systemctl --user is-active --quiet "$svc" || return 0
        else
            systemctl is-active --quiet "$svc" || return 0
        fi
        sleep 0.1
    done
    echo "warning: $svc did not become inactive" >&2
    return 1
}

stop_wg() {
    sudo systemctl stop "$WG_SERVICE" 2>/dev/null || true
    wait_inactive system "$WG_SERVICE" || true
}

stop_xray() {
    systemctl --user stop "$XRAY_SERVICE" 2>/dev/null || true
    wait_inactive user "$XRAY_SERVICE" || true
}

do_off() {
    stop_wg
    stop_xray
}

do_wg() {
    stop_xray
    sudo systemctl start "$WG_SERVICE"
    if systemctl --user is-active --quiet "$XRAY_SERVICE"; then
        stop_xray
    fi
}

do_xray() {
    stop_wg
    systemctl --user start "$XRAY_SERVICE"
    if systemctl is-active --quiet "$WG_SERVICE"; then
        stop_wg
    fi
}

do_cycle() {
    case "$(get_status)" in
        off)  do_wg ;;
        wg)   do_xray ;;
        xray) do_off ;;
    esac
}

status_cmd() {
    local symbol=0 colored_symbol=0 full=0
    shift  # drop "status"

    for arg in "$@"; do
        case "$arg" in
            -s|--symbol)          symbol=1 ;;
            -cs|--coloredsymbol)  colored_symbol=1 ;;
            --full)               full=1 ;;
            *)
                echo "vpn: unknown option for 'status': $arg" >&2
                usage >&2
                exit 1
                ;;
        esac
    done

    if (( full )); then
        status_full
    elif (( colored_symbol )); then
        get_symbol_colored
    elif (( symbol )); then
        get_symbol
    else
        get_status
    fi
}

case "${1:-}" in
    "")
        usage
        ;;
    help|-h|--help)
        usage
        ;;
    cycle)
        do_cycle
        ;;
    off)
        do_off
        ;;
    wg)
        do_wg
        ;;
    xray)
        do_xray
        ;;
    status)
        status_cmd "$@"
        ;;
    *)
        echo "vpn: unknown command: $1" >&2
        usage >&2
        exit 1
        ;;
esac
