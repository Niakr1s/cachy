#!/usr/bin/env bash
set -euo pipefail

WG_SERVICE="awg-quick@wg0.service"          # system: WireGuard tunnel
XRAY_USER_SERVICE="xray-knife.service"      # user (systemctl --user): local proxy
XRAY_SERVICE="xray-knife.service"           # system: full Xray‑knife tunnel

# ANSI colors
RED=$'\033[31m'
GREEN=$'\033[32m'
RESET=$'\033[0m'

usage() {
    cat <<'EOF'
Usage: vpn <command>

Commands:
   cycle                   Cycle state: off → wg → proxy → tun → off
   cycle-backwards         Reverse the cycle: tun → proxy → wg → off → tun
   restart                 Restart the currently active VPN mode's service
   off                     Stop all VPN services
   on <mode>               Start one VPN mode and stop the others:
       wg      WireGuard (awg-quick@wg0)
       proxy   user‑level Xray proxy (xray-knife, --user)
       tun     system Xray tunnel (xray-knife, sudo)
   list                    List available VPN modes with descriptions
   status                  Print current state: off | wg | proxy | tun
   status --full           Print full systemctl status of active service
   status -s               Print symbol: ⓞ | ⓦ | ⓟ | ⓣ
                           (alias: --symbol)
   status -cs              Print colored symbol (red=off, green=on)
                           (alias: --coloredsymbol)
   help, -h, --help        Show this help

Run with no arguments to print this usage.
EOF
}

get_status() {
    if systemctl is-active --quiet "$WG_SERVICE"; then
        echo "wg"
    elif systemctl --user is-active --quiet "$XRAY_USER_SERVICE"; then
        echo "proxy"
    elif systemctl is-active --quiet "$XRAY_SERVICE"; then
        echo "tun"
    else
        echo "off"
    fi
}

get_symbol() {
    case "$(get_status)" in
        off)     echo "ⓞ" ;;  # U+24DE
        wg)      echo "ⓦ" ;;  # U+24E6
        proxy)   echo "ⓟ" ;;  # U+24DF (proxied user proxy)
        tun)     echo "ⓣ" ;;  # U+24E3 (tunnel)
    esac
}

get_symbol_colored() {
    local s
    s="$(get_status)"
    case "$s" in
        off)          printf '%s%s%s\n' "$RED"   "$(get_symbol)" "$RESET" ;;
        wg|proxy|tun) printf '%s%s%s\n' "$GREEN" "$(get_symbol)" "$RESET" ;;
    esac
}

status_full() {
    local cur
    cur="$(get_status)"

    case "$cur" in
        off)
            echo "off"
            return 0
            ;;
        wg)
            echo "=== $WG_SERVICE (system) ==="
            if systemctl list-unit-files --no-legend "$WG_SERVICE" 2>/dev/null | grep -q .; then
                systemctl status -l "$WG_SERVICE" --no-pager || true
            else
                echo "unit not found"
            fi
            ;;
        proxy)
            echo "=== $XRAY_USER_SERVICE (user proxy) ==="
            if systemctl --user list-unit-files --no-legend "$XRAY_USER_SERVICE" 2>/dev/null | grep -q .; then
                systemctl --user status -l "$XRAY_USER_SERVICE" --no-pager || true
            else
                echo "unit not found"
            fi
            ;;
        tun)
            echo "=== $XRAY_SERVICE (system tunnel) ==="
            if systemctl list-unit-files --no-legend "$XRAY_SERVICE" 2>/dev/null | grep -q .; then
                systemctl status -l "$XRAY_SERVICE" --no-pager || true
            else
                echo "unit not found"
            fi
            ;;
    esac
}

wait_inactive() {
    local scope="$1" svc="$2" i
    for i in $(seq 1 30); do
        if [[ "$scope" == "user" ]]; then
            systemctl --user is-active --quiet "$svc" || return 0
        else
            systemctl is-active --quiet "$svc" || return 0
        fi
        sleep 0.1
    done
    echo "warning: $svc did not become inactive" >&2
    return 1
}

stop_wg() {
    sudo systemctl stop "$WG_SERVICE" 2>/dev/null || true
    wait_inactive system "$WG_SERVICE" || true
}

stop_xray_user() {
    systemctl --user stop "$XRAY_USER_SERVICE" 2>/dev/null || true
    wait_inactive user "$XRAY_USER_SERVICE" || true
}

stop_xray() {
    sudo systemctl stop "$XRAY_SERVICE" 2>/dev/null || true
    wait_inactive system "$XRAY_SERVICE" || true
}

# Each state is exclusive: it stops the other two services before starting its own.
do_off() {
    stop_wg
    stop_xray_user
    stop_xray
}

do_wg() {
    stop_xray_user
    stop_xray
    sudo systemctl start "$WG_SERVICE"
}

do_proxy() {
    stop_wg
    stop_xray
    systemctl --user start "$XRAY_USER_SERVICE"
}

do_tun() {
    stop_wg
    stop_xray_user
    sudo systemctl start "$XRAY_SERVICE"
}

do_cycle() {
    case "$(get_status)" in
        off)     do_wg ;;
        wg)      do_proxy ;;
        proxy)   do_tun ;;
        tun)     do_off ;;
    esac
}

# Move to the predecessor state in the forward loop (reverse of do_cycle).
do_cycle_backward() {
    case "$(get_status)" in
        off)     do_tun ;;
        wg)      do_off ;;
        proxy)   do_wg ;;
        tun)     do_proxy ;;
    esac
}

# Start exactly one VPN mode and stop the others.
do_on() {
    local mode="${1:-}"
    case "$mode" in
        off)     do_off ;;
        wg)      do_wg ;;
        proxy)   do_proxy ;;
        tun)     do_tun ;;
        *)
            echo "vpn: unknown mode '$mode' for 'on'" >&2
            echo "usage: vpn on <wg|proxy|tun>" >&2
            usage >&2
            exit 1
            ;;
    esac
}

# Restart the currently active mode's underlying service only.
do_restart() {
    case "$(get_status)" in
        wg)      sudo systemctl restart "$WG_SERVICE" ;;
        proxy)   systemctl --user restart "$XRAY_USER_SERVICE" ;;
        tun)     sudo systemctl restart "$XRAY_SERVICE" ;;
        off)     echo "vpn: no active VPN mode to restart" >&2; exit 0 ;;
    esac
}

# List available VPN modes with short descriptions (for `vpn on <mode>`).
do_list() {
    printf '%-5s  -  %s\n' \
        wg      'WireGuard tunnel (awg-quick@wg0)' \
        proxy   'Local Xray proxy (xray-knife, --user)' \
        tun     'System Xray tunnel (xray-knife, sudo)'
}

status_cmd() {
    local symbol=0 colored_symbol=0 full=0
    shift  # drop "status"

    for arg in "$@"; do
        case "$arg" in
            -s|--symbol)          symbol=1 ;;
            -cs|--coloredsymbol)  colored_symbol=1 ;;
            --full)               full=1 ;;
            *)
                echo "vpn: unknown option for 'status': $arg" >&2
                usage >&2
                exit 1
                ;;
        esac
    done

    if (( full )); then
        status_full
    elif (( colored_symbol )); then
        get_symbol_colored
    elif (( symbol )); then
        get_symbol
    else
        get_status
    fi
}

case "${1:-}" in
    "")
        usage
        ;;
    help|-h|--help)
        usage
        ;;
    cycle)
        do_cycle
        ;;
    cycle-backwards)
        do_cycle_backward
        ;;
    restart)
        do_restart
        ;;
    off)
        do_off
        ;;
    on)
        do_on "${2:-}"
        ;;
    list)
        do_list
        ;;
    status)
        status_cmd "$@"
        ;;
    *)
        echo "vpn: unknown command: $1" >&2
        usage >&2
        exit 1
        ;;
esac
