" ============================================================================
" [[ Basic Settings ]]
" ============================================================================
set number              " Show line numbers
set norelativenumber    " Explicitly turn off relative line numbers
set mouse=a             " Enable mouse support
set showmode            " Kept standard for Vim (since your Neovim statusline plugin is removed)
set undofile            " Save undo history
set ignorecase          " Case-insensitive searching
set smartcase           " But be smart about it
set signcolumn=yes      " Keep sign column always visible
set updatetime=250      " Faster update time
set timeoutlen=500     " Faster key sequence timeout
set splitright          " New splits open to the right
set splitbelow          " New splits open below
set list                " Show invisible characters
set listchars=tab:»\ ,trail:·,nbsp:␣
set nocursorline        " Explicitly turn off highlight current line
set scrolloff=10        " Keep 10 lines below/above cursor
set sidescrolloff=8     " Keep 8 columns side scrolling
set termguicolors       " True colour support
set noswapfile          " Disable swap files

" ============================================================================
" [[ Indent Options: 2 spaces ]]
" ============================================================================
set breakindent         " Better indentation for wrapped lines
set autoindent          " Copy indent from current line when starting a new line
set nosmartindent       " Turn off smart autoindenting
set nocindent           " Turn off C-style indenting
set copyindent          " Copy the structure of existing lines indent when autoindenting
set fixendofline        " Equivalent to vim.opt.fixeol = false

set tabstop=2           " Number of spaces a tab counts for
set softtabstop=2       " Number of spaces for editing (backspace)
set shiftwidth=2        " Number of spaces for auto-indent
set expandtab           " Convert tabs to spaces

" ============================================================================
" [[ Key Mappings ]]
" ============================================================================
" Set space as leader and localleader keys
let mapleader = " "
let maplocalleader = " "

" --- Tab Navigation (Ctrl+w combinations) ---
nnoremap <silent> <C-w>, :tabprevious<CR>
nnoremap <silent> <C-w>. :tabnext<CR>
nnoremap <silent> <C-w>< :<C-u>execute "tabmove " . (tabpagenr() - 2)<CR>
nnoremap <silent> <C-w>> :<C-u>execute "tabmove " . tabpagenr()<CR>

" --- Format and Save ---
" Note: Formatter calls are modified to run native ':w' since 'conform.nvim' is absent
nnoremap <leader>w :w<CR>
nnoremap <leader>W :w<CR>

" --- Windows and Split Layout Overrides ---
nnoremap <C-w><C-v> <Nop>
nnoremap <C-w><C-c> <Nop>
nnoremap <C-w><C-t> <Nop>
nnoremap <C-w><C-p> <Nop>
nnoremap <C-w><C-n> <Nop>

nnoremap <silent> <C-w>v :vsplit<CR>
nnoremap <silent> <C-w>c :split<CR>
nnoremap <silent> <C-w>t :tabnew<CR>
nnoremap <silent> <C-w>p :tabprevious<CR>
nnoremap <silent> <C-w>n :tabnext<CR>
nnoremap <silent> <C-w>q :confirm close<CR> 
nnoremap <silent> <C-w>] gt
nnoremap <silent> <C-w>[ gT

" --- Quick Jump to Tab 1 through 9 ---
nnoremap <silent> <C-w>1 :tabnext 1<CR>
nnoremap <silent> <C-w>2 :tabnext 2<CR>
nnoremap <silent> <C-w>3 :tabnext 3<CR>
nnoremap <silent> <C-w>4 :tabnext 4<CR>
nnoremap <silent> <C-w>5 :tabnext 5<CR>
nnoremap <silent> <C-w>6 :tabnext 6<CR>
nnoremap <silent> <C-w>7 :tabnext 7<CR>
nnoremap <silent> <C-w>8 :tabnext 8<CR>
nnoremap <silent> <C-w>9 :tabnext 9<CR>

" --- Visual Mode Indenting ---
vnoremap < <gv
vnoremap > >gv

" --- Navigation Improvements (Keep cursor centered) ---
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap n nzzzv
nnoremap N Nzzzv

" --- Clear Search Highlighting ---
nnoremap <silent> <leader>n :noh<CR>

" --- Reload Vim Configuration ---
command! Source source ~/.vimrc | echo "Configuration reloaded!"

