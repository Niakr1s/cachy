{
  "mcpServers": {
    "duckduckgo": {
      "command": "uvx",
      "args": [
        "--with",
        "duckduckgo-mcp-server[browser]",
        "duckduckgo-mcp-server",
        "--fetch-backend",
        "auto"
      ],
      "env": {
        "DDG_SAFE_SEARCH": "OFF",
        "DDG_REGION": "us-en"
      }
    },
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch",
        "--ignore-robots-txt"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }
  }
}
